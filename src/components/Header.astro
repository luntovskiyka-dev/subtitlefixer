---
import Logo from './Logo.astro';
import { KOFI_URL } from '../config/site';
import { toolMeta } from '../data/tools';
import { pagePath } from '../lib/ui/pagePath';

const current = pagePath(Astro.url.pathname);

const dot = {
  shift: 'bg-tool-shift-bg',
  drift: 'bg-tool-drift-bg',
  enc: 'bg-tool-enc-bg',
  s2v: 'bg-tool-s2v-bg',
  v2s: 'bg-tool-v2s-bg',
  ass: 'bg-tool-ass-bg',
  s2t: 'bg-tool-s2t-bg',
  t2s: 'bg-tool-t2s-bg',
} as const;

const linkClass =
  'group inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border-2 px-3.5 py-2 text-[14.5px] font-bold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-hover';
---

<header class="min-w-0 bg-bg">
  <div class="mx-auto flex min-h-[60px] w-full max-w-[1180px] items-center gap-6 px-3 sm:px-6 md:min-h-[76px]">
    <Logo current={current === '/'} />
    <a
      href={KOFI_URL}
      target="_blank"
      rel="noopener"
      aria-label="Support: buy me a coffee on Ko-fi (opens in a new tab)"
      class="ml-auto inline-flex shrink-0 items-center whitespace-nowrap rounded-full border-2 border-edge bg-accent px-3.5 py-1.5 text-[13px] font-extrabold text-on-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-hover"
    >
      <span class="sm:hidden">☕ Support</span>
      <span class="hidden sm:inline">☕ Buy me a coffee</span>
    </a>
  </div>
  <nav
    class="sf-nav-scroll sf-nav-center mx-auto flex w-full min-w-0 max-w-[1180px] gap-1.5 overflow-x-auto px-3 pb-3 sm:px-6"
    aria-label="Tools"
  >
    {
      toolMeta.map((tool) => {
        const active = current === `/${tool.slug}`;
        return (
          <a
            href={`/${tool.slug}`}
            class:list={[
              linkClass,
              active ? 'border-edge bg-nav-active text-on-nav' : 'border-edge bg-surface text-ink',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            <span
              class:list={[
                'size-2.5 rounded-full border-[1.5px] border-edge group-aria-[current=page]:border-on-nav',
                dot[tool.key],
              ]}
            />
            {tool.nav}
          </a>
        );
      })
    }
  </nav>
</header>
