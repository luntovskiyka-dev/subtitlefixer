---
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex w-full max-w-3xl items-center px-4 py-5 sm:px-6">
    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-sf text-lg tracking-tight text-brand hover:text-brand-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand"
      aria-label="subtitlefixer"
      aria-current={current === '/' ? 'page' : undefined}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="size-5 shrink-0"
      >
        <path
          fill-rule="evenodd"
          d="M3.55 5.5H20.45A1.8 1.8 0 0 1 22.25 7.3V16.7A1.8 1.8 0 0 1 20.45 18.5H3.55A1.8 1.8 0 0 1 1.75 16.7V7.3A1.8 1.8 0 0 1 3.55 5.5ZM4.2 7.25H19.8A0.7 0.7 0 0 1 20.5 7.95V16.05A0.7 0.7 0 0 1 19.8 16.75H4.2A0.7 0.7 0 0 1 3.5 16.05V7.95A0.7 0.7 0 0 1 4.2 7.25ZM5.45 9.2H18.35A0.45 0.45 0 0 1 18.8 9.65V10.9A0.45 0.45 0 0 1 18.35 11.35H5.45A0.45 0.45 0 0 1 5 10.9V9.65A0.45 0.45 0 0 1 5.45 9.2ZM5.45 12.7H13.45A0.45 0.45 0 0 1 13.9 13.15V14.4A0.45 0.45 0 0 1 13.45 14.85H5.45A0.45 0.45 0 0 1 5 14.4V13.15A0.45 0.45 0 0 1 5.45 12.7Z"
        />
      </svg>
      <span class="font-normal">subtitle</span><span class="font-bold">fixer</span>
    </a>
  </div>
</header>
