---
import { statusCopy, type ToolPhase } from '../lib/ui/status';

interface Props {
  id: string;
  phase?: ToolPhase;
  fileNames?: readonly string[];
}

const { id, phase = 'empty', fileNames = [] } = Astro.props;
const copy = statusCopy(phase, fileNames);
const detailClass = phase === 'error' ? 'text-sm text-danger' : 'text-sm text-muted';
---

<div id={id} role="status" class="flex flex-col gap-1">
  {
    phase === 'ready' ? (
      <div class="flex items-center gap-2">
        <span class="inline-flex size-6 shrink-0 items-center justify-center rounded-sf bg-mint">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="size-4 text-success"
          >
            <path
              d="M5 13l4 4L19 7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <p class="text-sm font-medium text-ink">{copy.title}</p>
      </div>
    ) : (
      <p class="text-sm font-medium text-ink">{copy.title}</p>
    )
  }
  <p class={detailClass}>{copy.detail}</p>
</div>
