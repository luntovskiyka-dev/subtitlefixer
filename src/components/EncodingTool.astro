---
import Button from './Button.astro';
import Dropzone from './Dropzone.astro';
import ToolLayout from './ToolLayout.astro';
import ToolStatus from './ToolStatus.astro';

const formats = [
  { label: 'SRT', tone: 'accent-soft' },
  { label: 'VTT', tone: 'mint' },
  { label: 'ASS', tone: 'lilac' },
  { label: 'SSA', tone: 'teal-soft' },
  { label: 'SUB', tone: 'accent-soft' },
  { label: 'TXT', tone: 'mint' },
] as const;
---

<form id="encoding-form">
  <ToolLayout>
    <div slot="input" class="flex flex-col gap-3">
      <Dropzone
        id="encoding-dropzone"
        variant="stage"
        label="Add a subtitle file"
        stageTitle="Add a subtitle file"
        formats={formats}
        accept=".srt,.vtt,.ass,.ssa,.sub,.txt"
        interactive
      />
      <ToolStatus id="encoding-status" tone="stage" />
    </div>
    <div slot="preview">
      <div
        id="encoding-candidates"
        class="sf-preview-scroll flex flex-col gap-3"
        tabindex="0"
        aria-label="Encoding readings"
      >
        <p class="text-sm font-medium text-on-brand-muted">Add a subtitle file to compare readings.</p>
      </div>
    </div>
    <div slot="settings">
      <h2 class="font-display text-[22px] font-extrabold">Settings</h2>
      <div class="mt-3.5 flex flex-col gap-2">
        <label for="encoding-label" class="text-sm font-extrabold">Encoding</label>
        <select id="encoding-label" name="language" class="sf-field">
          <option value="utf-8">UTF-8</option>
          <option value="windows-1251">Windows-1251</option>
          <option value="windows-1252">Windows-1252</option>
          <option value="windows-1256">Windows-1256</option>
          <option value="iso-8859-7">ISO-8859-7</option>
          <option value="iso-8859-8">ISO-8859-8</option>
          <option value="iso-8859-9">ISO-8859-9</option>
          <option value="shift_jis">Shift_JIS</option>
          <option value="gb18030">GB18030</option>
        </select>
      </div>
      <div class="mt-4 flex min-h-11 items-center gap-3">
        <input id="encoding-bom" name="bom" type="checkbox" class="sf-check" />
        <label for="encoding-bom" class="text-sm font-extrabold">Include UTF-8 BOM</label>
      </div>
    </div>
    <div slot="action">
      <Button id="encoding-download" type="submit" size="lg" class="w-full gap-2" softDisabled hint="Add a file to enable the download.">
        Download UTF-8 file
      </Button>
      <p class="mt-3.5 flex items-center justify-center gap-2 text-[13px] font-bold">
        Your file never leaves your device.
      </p>
      <div
        id="encoding-output"
        class="sf-preview-scroll sf-preview-in-panel mt-3"
        tabindex="0"
        aria-label="Decoded subtitle preview"
        hidden
      >
        <p id="encoding-output-tag" class="text-[12.5px] font-extrabold"></p>
        <pre id="encoding-output-text" class="sf-preview-text"></pre>
      </div>
      <div id="encoding-result" class="mt-3" aria-live="polite"></div>
    </div>
  </ToolLayout>
</form>

<script>
  import type { DecodedSubtitleFile } from '../lib/subs/files';
  import {
    candidateDecodings,
    decodeWithLabel,
    downloadSubtitleFiles,
    repairMojibake,
  } from '../lib/subs/index';
  import type { MojibakeVia } from '../lib/subs/index';
  import { slicePreviewLines } from '../lib/ui/previewSlice';
  import { renderStatus } from '../lib/ui/statusView';

  const LANGUAGE_LABELS = [
    'utf-8',
    'windows-1251',
    'windows-1252',
    'windows-1256',
    'iso-8859-7',
    'iso-8859-8',
    'iso-8859-9',
    'shift_jis',
    'gb18030',
  ] as const;

  const MOJIBAKE_VALUE = 'mojibake';

  const form = document.getElementById('encoding-form');
  const labelSelect = document.getElementById('encoding-label');
  const bomInput = document.getElementById('encoding-bom');
  const candidates = document.getElementById('encoding-candidates');
  const result = document.getElementById('encoding-result');
  const status = document.getElementById('encoding-status');
  const download = document.getElementById('encoding-download');
  const hint = document.getElementById('encoding-download-hint');
  const meta = document.querySelector('#encoding-dropzone [data-file-meta]');

  let files: DecodedSubtitleFile[] = [];
  let encodingLabel: (typeof LANGUAGE_LABELS)[number] = 'utf-8';

  function mojibakeHeading(via: MojibakeVia): string {
    if (via === 'windows-1252') return 'UTF-8 read as Windows-1252';
    return 'UTF-8 read as Windows-1251';
  }

  function isLanguageLabel(label: string): label is (typeof LANGUAGE_LABELS)[number] {
    return (LANGUAGE_LABELS as readonly string[]).includes(label);
  }

  function isDecodedFile(file: unknown): file is DecodedSubtitleFile {
    if (typeof file !== 'object' || file === null) return false;
    if (!('name' in file) || !('encoding' in file) || !('text' in file) || !('bytes' in file)) {
      return false;
    }
    return (
      typeof file.name === 'string' &&
      typeof file.encoding === 'string' &&
      typeof file.text === 'string' &&
      file.bytes instanceof Uint8Array
    );
  }

  function showError(message: string): void {
    const output = document.getElementById('encoding-output');
    if (output instanceof HTMLElement) output.hidden = true;
    if (!(result instanceof HTMLElement)) return;
    result.replaceChildren();
    const paragraph = document.createElement('p');
    paragraph.className = 'sf-msg sf-rise';
    paragraph.textContent = message;
    result.append(paragraph);
  }

  function showText(text: string): void {
    const output = document.getElementById('encoding-output');
    const preview = document.getElementById('encoding-output-text');
    const tag = document.getElementById('encoding-output-tag');
    if (!(output instanceof HTMLElement) || !(preview instanceof HTMLElement) || !(tag instanceof HTMLElement)) return;
    const sliced = slicePreviewLines(text);
    preview.textContent = sliced.preview;
    tag.textContent = sliced.caption;
    output.hidden = false;
    if (result instanceof HTMLElement) result.replaceChildren();
  }

  function appendPreview(value: string, headingText: string, text: string, detected: boolean): void {
    if (!(candidates instanceof HTMLElement)) return;
    const block = document.createElement('button');
    block.type = 'button';
    block.className = 'sf-candidate';
    block.dataset.label = value;
    block.setAttribute('aria-pressed', 'false');
    const heading = document.createElement('p');
    heading.className = 'flex flex-wrap items-center gap-2 text-sm font-extrabold';
    heading.append(document.createTextNode(headingText));
    if (detected) {
      const mark = document.createElement('span');
      mark.className = 'sf-pill';
      mark.textContent = 'Detected';
      heading.append(mark);
    }
    const sliced = slicePreviewLines(text);
    const preview = document.createElement('pre');
    preview.textContent = sliced.preview;
    block.append(heading);
    if (sliced.total > sliced.shown) {
      const cap = document.createElement('p');
      cap.className = 'sf-preview-cap';
      cap.textContent = sliced.caption;
      block.append(cap);
    }
    block.append(preview);
    candidates.append(block);
  }

  function markSelected(): void {
    if (!(candidates instanceof HTMLElement) || !(labelSelect instanceof HTMLSelectElement)) return;
    for (const card of candidates.querySelectorAll('[data-label]')) {
      if (!(card instanceof HTMLElement)) continue;
      card.setAttribute('aria-pressed', card.dataset.label === labelSelect.value ? 'true' : 'false');
    }
  }

  function syncMojibakeOption(via: MojibakeVia | null): void {
    if (!(labelSelect instanceof HTMLSelectElement)) return;
    const existing = [...labelSelect.options].find((option) => option.value === MOJIBAKE_VALUE);
    if (!via) {
      existing?.remove();
      return;
    }
    const label = mojibakeHeading(via);
    if (existing) {
      existing.textContent = label;
      return;
    }
    const option = document.createElement('option');
    option.value = MOJIBAKE_VALUE;
    option.textContent = label;
    labelSelect.append(option);
  }

  async function showCandidates(
    bytes: Uint8Array,
    decodedText: string,
  ): Promise<(typeof LANGUAGE_LABELS)[number]> {
    if (!(candidates instanceof HTMLElement)) return 'utf-8';
    const readings = (await candidateDecodings(bytes)).slice(0, 4);
    candidates.replaceChildren();
    readings.forEach((reading, index) => {
      appendPreview(reading.encoding, reading.encoding, reading.text, index === 0);
    });
    const repair = repairMojibake(decodedText);
    syncMojibakeOption(repair?.via ?? null);
    if (repair) appendPreview(MOJIBAKE_VALUE, mojibakeHeading(repair.via), repair.text, false);
    const detected = readings[0]?.encoding ?? 'utf-8';
    return isLanguageLabel(detected) ? detected : 'utf-8';
  }

  function mojibakeSelected(): boolean {
    return labelSelect instanceof HTMLSelectElement && labelSelect.value === MOJIBAKE_VALUE;
  }

  function showSelectedText(): void {
    const first = files[0];
    if (!first) return;
    if (mojibakeSelected()) {
      const repair = repairMojibake(first.text);
      if (repair) {
        showText(repair.text);
        return;
      }
    }
    showText(decodeWithLabel(first.bytes, encodingLabel).text);
  }

  if (
    form instanceof HTMLFormElement &&
    labelSelect instanceof HTMLSelectElement &&
    bomInput instanceof HTMLInputElement &&
    candidates instanceof HTMLElement &&
    result instanceof HTMLElement &&
    status instanceof HTMLElement &&
    download instanceof HTMLButtonElement
  ) {
    const names = () => files.map((file) => file.name);

    const setDownload = (enabled: boolean) => {
      if (enabled) download.removeAttribute('aria-disabled');
      else download.setAttribute('aria-disabled', 'true');
      if (hint instanceof HTMLElement) hint.hidden = enabled;
    };

    form.addEventListener('subtitlereading', () => {
      renderStatus(status, 'working', names());
    });

    form.addEventListener('subtitlefailed', () => {
      renderStatus(status, 'error', names());
    });

    form.addEventListener('subtitlefiles', (event) => {
      if (!(event instanceof CustomEvent)) return;
      const detail: unknown = event.detail;
      if (typeof detail !== 'object' || detail === null || !('files' in detail)) return;
      if (!Array.isArray(detail.files)) return;
      files = detail.files.filter(isDecodedFile);
      const first = files[0];
      setDownload(files.length > 0);
      if (meta instanceof HTMLElement && first) meta.textContent = first.encoding.replace(/^utf-8$/i, 'UTF-8');
      if (!first) {
        candidates.replaceChildren();
        syncMojibakeOption(null);
        showError('Add a subtitle file.');
        renderStatus(status, 'error', names());
        return;
      }
      renderStatus(status, 'loaded', names());
      void showCandidates(first.bytes, first.text)
        .then((label) => {
          encodingLabel = label;
          labelSelect.value = encodingLabel;
          showSelectedText();
          markSelected();
        })
        .catch(() => {
          showError('Could not read that subtitle file.');
          renderStatus(status, 'error', names());
        });
    });

    candidates.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const card = target.closest('[data-label]');
      if (!(card instanceof HTMLElement) || !candidates.contains(card)) return;
      labelSelect.value = card.dataset.label ?? '';
      if (isLanguageLabel(labelSelect.value)) encodingLabel = labelSelect.value;
      showSelectedText();
      markSelected();
    });

    labelSelect.addEventListener('change', () => {
      if (files.length === 0) return;
      if (isLanguageLabel(labelSelect.value)) encodingLabel = labelSelect.value;
      showSelectedText();
      markSelected();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (download.getAttribute('aria-disabled') === 'true') return;
      const chosen = names();
      renderStatus(status, 'working', chosen);
      if (files.length === 0) {
        showError('Add a subtitle file.');
        renderStatus(status, 'error', chosen);
        return;
      }
      const useRepair = mojibakeSelected();
      const ready = files.map((file) => {
        if (useRepair) {
          const repair = repairMojibake(file.text);
          if (repair) return { name: file.name, text: repair.text };
        }
        return { name: file.name, text: decodeWithLabel(file.bytes, encodingLabel).text };
      });
      showSelectedText();
      downloadSubtitleFiles(ready, bomInput.checked);
      renderStatus(status, 'ready', chosen);
    });
  }
</script>
