---
import Button from './Button.astro';
import Dropzone from './Dropzone.astro';
import ToolLayout from './ToolLayout.astro';
import ToolStatus from './ToolStatus.astro';

const formats = [
  { label: 'SRT', tone: 'accent-soft' },
  { label: 'VTT', tone: 'mint' },
  { label: 'ASS', tone: 'lilac' },
  { label: 'SSA', tone: 'teal-soft' },
] as const;
---

<form id="drift-form">
  <ToolLayout>
    <div slot="input" class="flex flex-col gap-3">
      <Dropzone
        id="drift-dropzone"
        variant="stage"
        label="Add an SRT, VTT, ASS, or SSA file"
        stageTitle="Add an SRT, VTT, ASS, or SSA file"
        formats={formats}
        interactive
      />
      <ToolStatus id="drift-status" tone="stage" />
    </div>
    <div slot="preview">
      <p id="drift-preview-empty" class="text-sm font-medium text-on-brand-muted">
        Sync two cues or pick a frame rate to preview the first lines.
      </p>
      <div id="drift-preview" class="rounded-sf-lg border-2.5 border-stage-line bg-surface px-4 py-3 text-ink" hidden>
        <div class="mb-1.5 flex items-center justify-between gap-3">
          <p class="font-display text-lg font-extrabold">Preview</p>
          <p id="drift-preview-tag" class="rounded-full border-2 border-stage-line bg-lilac px-2.5 py-0.5 text-[12.5px] font-extrabold"></p>
        </div>
        <div id="drift-preview-rows" class="sf-cue-list"></div>
      </div>
      <template id="drift-row">
        <div class="sf-cue-row">
          <p class="sf-cue-time"></p>
          <p class="sf-cue-text"></p>
        </div>
      </template>
    </div>
    <div slot="settings">
      <fieldset class="flex flex-col gap-3 border-0 p-0">
        <legend class="font-display text-[22px] font-extrabold">Two-point sync</legend>
        <div class="mt-3 flex flex-col gap-2">
          <label for="drift-cue-a" class="text-sm font-extrabold">First cue</label>
          <select id="drift-cue-a" name="cue-a" class="sf-field"></select>
        </div>
        <div class="flex flex-col gap-2">
          <label for="drift-time-a" class="text-sm font-extrabold">Correct time for the first cue</label>
          <input
            id="drift-time-a"
            name="time-a"
            type="text"
            inputmode="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="hh:mm:ss,mmm"
            aria-describedby="drift-time-hint"
            class="sf-field"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label for="drift-cue-b" class="text-sm font-extrabold">Second cue</label>
          <select id="drift-cue-b" name="cue-b" class="sf-field"></select>
        </div>
        <div class="flex flex-col gap-2">
          <label for="drift-time-b" class="text-sm font-extrabold">Correct time for the second cue</label>
          <input
            id="drift-time-b"
            name="time-b"
            type="text"
            inputmode="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="hh:mm:ss,mmm"
            aria-describedby="drift-time-hint"
            class="sf-field"
          />
          <p id="drift-time-hint" class="text-sm text-muted">Use hh:mm:ss,mmm, for example 00:01:05,480.</p>
        </div>
      </fieldset>
      <div class="mt-4 flex min-h-11 items-center gap-3">
        <input id="drift-bom" name="bom" type="checkbox" class="sf-check" />
        <label for="drift-bom" class="text-sm font-extrabold">Add BOM (old players)</label>
      </div>
    </div>
    <div slot="action">
      <Button id="drift-download" type="submit" size="lg" class="w-full gap-2" softDisabled hint="Add a file to enable the download.">
        Download synced file
      </Button>
      <p class="mt-3.5 flex items-center justify-center gap-2 text-[13px] font-bold">
        Your file never leaves your device.
      </p>
      <div id="drift-result" class="mt-3" aria-live="polite"></div>
    </div>
  </ToolLayout>
</form>

<script>
  import type { DecodedSubtitleFile } from '../lib/subs/files';
  import { downloadSubtitleFiles, FPS_23_976, parse, scaleSubtitleFile, syncSubtitleFile } from '../lib/subs/index';
  import type { DriftFileResult } from '../lib/subs/index';
  import type { Cue, SubtitleFormat } from '../lib/subs/types';
  import { formatSrtTimestamp, parseSrtTimestamp } from '../lib/subs/time';
  import { renderStatus } from '../lib/ui/statusView';

  const form = document.getElementById('drift-form');
  const cueA = document.getElementById('drift-cue-a');
  const cueB = document.getElementById('drift-cue-b');
  const timeA = document.getElementById('drift-time-a');
  const timeB = document.getElementById('drift-time-b');
  const fps = document.getElementById('drift-fps');
  const bomInput = document.getElementById('drift-bom');
  const result = document.getElementById('drift-result');
  const status = document.getElementById('drift-status');
  const download = document.getElementById('drift-download');
  const hint = document.getElementById('drift-download-hint');
  const meta = document.querySelector('#drift-dropzone [data-file-meta]');

  const fpsPresets: Record<string, { subtitle: number; video: number }> = {
    '23.976 → 25': { subtitle: FPS_23_976, video: 25 },
    '25 → 23.976': { subtitle: 25, video: FPS_23_976 },
    '24 → 25': { subtitle: 24, video: 25 },
    '25 → 24': { subtitle: 25, video: 24 },
    '23.976 → 24': { subtitle: FPS_23_976, video: 24 },
    '24 → 23.976': { subtitle: 24, video: FPS_23_976 },
  };

  let files: DecodedSubtitleFile[] = [];
  let cues: Cue[] = [];

  function formatOf(name: string): SubtitleFormat | null {
    const lower = name.toLowerCase();
    if (lower.endsWith('.srt')) return 'srt';
    if (lower.endsWith('.vtt')) return 'vtt';
    if (lower.endsWith('.ass') || lower.endsWith('.ssa')) return 'ass';
    return null;
  }

  function isDecodedFile(file: unknown): file is DecodedSubtitleFile {
    if (typeof file !== 'object' || file === null) return false;
    if (!('name' in file) || !('encoding' in file) || !('text' in file)) return false;
    return (
      typeof file.name === 'string' &&
      typeof file.encoding === 'string' &&
      typeof file.text === 'string'
    );
  }

  function cueLabel(index: number, cue: Cue): string {
    const text = cue.text.replace(/\s+/g, ' ').trim();
    const snippet = text.length > 48 ? `${text.slice(0, 48)}…` : text;
    return `${index + 1}. ${formatSrtTimestamp(cue.start)} ${snippet}`;
  }

  function fillSelect(select: HTMLSelectElement, labels: readonly string[]): void {
    select.replaceChildren();
    labels.forEach((label, index) => {
      const option = document.createElement('option');
      option.value = String(index);
      option.textContent = label;
      select.append(option);
    });
  }

  function showResult(messages: readonly string[], warnings: readonly string[]): void {
    if (!(result instanceof HTMLElement)) return;
    result.replaceChildren();
    for (const message of messages) {
      const paragraph = document.createElement('p');
      paragraph.className = 'sf-msg sf-rise';
      paragraph.textContent = message;
      result.append(paragraph);
    }
    for (const message of warnings) {
      const paragraph = document.createElement('p');
      paragraph.className = 'sf-msg sf-warn sf-rise';
      paragraph.textContent = message;
      result.append(paragraph);
    }
  }

  function paintPreview(output: DriftFileResult | null): void {
    const live = document.getElementById('drift-preview');
    const empty = document.getElementById('drift-preview-empty');
    const rows = document.getElementById('drift-preview-rows');
    const tag = document.getElementById('drift-preview-tag');
    const tpl = document.getElementById('drift-row');
    if (!(live instanceof HTMLElement) || !(rows instanceof HTMLElement) || !(tag instanceof HTMLElement)) return;
    const root = tpl instanceof HTMLTemplateElement ? tpl.content.firstElementChild : null;
    if (!(root instanceof HTMLElement) || !output || output.cues.length === 0) {
      live.hidden = true;
      if (empty instanceof HTMLElement) empty.hidden = false;
      return;
    }
    const shown = output.cues.slice(0, 5);
    const frag = document.createDocumentFragment();
    for (const cue of shown) {
      const line = root.cloneNode(true) as HTMLElement;
      const cells = line.children;
      cells[0].textContent = `${formatSrtTimestamp(cue.start)} --> ${formatSrtTimestamp(cue.end)}`;
      cells[1].textContent = cue.text;
      frag.append(line);
    }
    rows.replaceChildren(frag);
    tag.textContent =
      output.cues.length > shown.length
        ? `Showing the first ${shown.length} of ${output.cues.length} cues.`
        : `${shown.length} ${shown.length === 1 ? 'cue' : 'cues'}`;
    live.hidden = false;
    if (empty instanceof HTMLElement) empty.hidden = true;
  }

  function adjustmentLine(output: DriftFileResult, fileName: string, several: boolean): string | null {
    if (output.removed === 0 && output.trimmed === 0) return null;
    const line = `${output.removed} lines removed / ${output.trimmed} lines trimmed`;
    return several ? `${fileName}: ${line}` : line;
  }

  if (
    form instanceof HTMLFormElement &&
    cueA instanceof HTMLSelectElement &&
    cueB instanceof HTMLSelectElement &&
    timeA instanceof HTMLInputElement &&
    timeB instanceof HTMLInputElement &&
    fps instanceof HTMLElement &&
    bomInput instanceof HTMLInputElement &&
    result instanceof HTMLElement &&
    status instanceof HTMLElement &&
    download instanceof HTMLButtonElement
  ) {
    const names = () => files.map((file) => file.name);

    const setDownload = (enabled: boolean) => {
      if (enabled) download.removeAttribute('aria-disabled');
      else download.setAttribute('aria-disabled', 'true');
      if (hint instanceof HTMLElement) hint.hidden = enabled;
    };

    const fail = (message: string): void => {
      showResult([message], []);
      paintPreview(null);
      renderStatus(status, 'error', names());
    };

    const loadCues = (): void => {
      cues = [];
      fillSelect(cueA, []);
      fillSelect(cueB, []);
      if (files.length !== 1) return;
      const file = files[0];
      if (!file) return;
      const format = formatOf(file.name);
      if (!format) return;
      cues = parse(file.text, format).cues;
      const labels = cues.map((cue, index) => cueLabel(index, cue));
      fillSelect(cueA, labels);
      fillSelect(cueB, labels);
      if (cues.length === 0) return;
      cueA.selectedIndex = 0;
      cueB.selectedIndex = cues.length - 1;
    };

    const deliver = (
      ready: { name: string; text: string }[],
      messages: string[],
      warnings: string[],
      output: DriftFileResult | null,
    ): void => {
      showResult(messages, ready.length > 0 ? warnings : []);
      paintPreview(ready.length > 0 ? output : null);
      if (ready.length === 0) {
        renderStatus(status, 'error', names());
        return;
      }
      downloadSubtitleFiles(ready, bomInput.checked);
      renderStatus(status, 'ready', names());
    };

    form.addEventListener('subtitlereading', () => {
      renderStatus(status, 'working', names());
    });

    form.addEventListener('subtitlefailed', () => {
      renderStatus(status, 'error', names());
    });

    form.addEventListener('subtitlefiles', (event) => {
      if (!(event instanceof CustomEvent)) return;
      const detail: unknown = event.detail;
      if (typeof detail !== 'object' || detail === null || !('files' in detail)) return;
      if (!Array.isArray(detail.files)) return;
      files = detail.files.filter(isDecodedFile);
      loadCues();
      setDownload(files.length > 0);
      if (meta instanceof HTMLElement && files[0]) {
        meta.textContent = files[0].encoding.replace(/^utf-8$/i, 'UTF-8');
      }
      renderStatus(status, files.length > 0 ? 'loaded' : 'empty', names());
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (download.getAttribute('aria-disabled') === 'true') return;
      renderStatus(status, 'working', names());
      if (files.length === 0) {
        fail('Add an SRT, VTT, or ASS file.');
        return;
      }
      if (files.length > 1) {
        fail('Two-point sync works on one file. Add a single subtitle file.');
        return;
      }

      const file = files[0];
      const format = file ? formatOf(file.name) : null;
      if (!file || !format) {
        fail('Use an SRT, VTT, or ASS file.');
        return;
      }
      if (cues.length < 2) {
        fail('This file needs two cues with different start times.');
        return;
      }

      const indexA = Number(cueA.value);
      const indexB = Number(cueB.value);
      const first = cues[indexA];
      const second = cues[indexB];
      if (!first || !second || !Number.isInteger(indexA) || !Number.isInteger(indexB)) {
        fail('Pick two cues from the list.');
        return;
      }
      if (indexA === indexB) {
        fail('Pick two different cues.');
        return;
      }
      if (first.start === second.start) {
        fail('Those two cues start at the same time. Pick cues with different start times.');
        return;
      }

      const t1Prime = parseSrtTimestamp(timeA.value);
      const t2Prime = parseSrtTimestamp(timeB.value);
      if (t1Prime === null || t2Prime === null) {
        fail('Enter each correct time as hh:mm:ss,mmm.');
        return;
      }

      let output: DriftFileResult;
      try {
        output = syncSubtitleFile(file.text, format, first.start, t1Prime, second.start, t2Prime);
      } catch (error) {
        fail(error instanceof Error ? error.message : 'Those two cues cannot be synced.');
        return;
      }

      const messages = output.errors.map((parseError) => `${file.name}: ${parseError.message}`);
      if (output.cues.length === 0 && output.removed === 0) {
        deliver([], messages.length > 0 ? messages : [`${file.name}: This file has no cues.`], [], null);
        return;
      }
      const warning = adjustmentLine(output, file.name, false);
      deliver([{ name: file.name, text: output.text }], messages, warning ? [warning] : [], output);
    });

    fps.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('button');
      if (!(button instanceof HTMLButtonElement) || !fps.contains(button)) return;
      const rates = fpsPresets[(button.textContent ?? '').trim()];
      if (!rates) return;
      for (const preset of fps.querySelectorAll('button')) preset.setAttribute('aria-pressed', preset === button ? 'true' : 'false');

      renderStatus(status, 'working', names());
      if (files.length === 0) {
        fail('Add an SRT, VTT, or ASS file.');
        return;
      }

      const messages: string[] = [];
      const warnings: string[] = [];
      const ready: { name: string; text: string }[] = [];
      let firstOutput: DriftFileResult | null = null;

      for (const file of files) {
        const format = formatOf(file.name);
        if (!format) {
          messages.push(`${file.name}: Use an SRT, VTT, or ASS file.`);
          continue;
        }
        let output: DriftFileResult;
        try {
          output = scaleSubtitleFile(file.text, format, rates.subtitle, rates.video);
        } catch (error) {
          messages.push(error instanceof Error ? `${file.name}: ${error.message}` : `${file.name}: Could not scale.`);
          continue;
        }
        for (const parseError of output.errors) messages.push(`${file.name}: ${parseError.message}`);
        if (output.cues.length === 0 && output.removed === 0) {
          if (output.errors.length === 0) messages.push(`${file.name}: This file has no cues.`);
          continue;
        }
        if (!firstOutput) firstOutput = output;
        const warning = adjustmentLine(output, file.name, files.length > 1);
        if (warning) warnings.push(warning);
        ready.push({ name: file.name, text: output.text });
      }

      deliver(ready, messages, warnings, firstOutput);
    });
  }
</script>
