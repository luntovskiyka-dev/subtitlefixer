---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', type = 'button' } = Astro.props;

const variantClass = {
  primary: 'bg-brand text-bg hover:bg-brand-hover',
  secondary: 'bg-brand-soft text-brand hover:text-brand-hover',
  ghost: 'bg-transparent text-brand hover:text-brand-hover',
}[variant];
---

<button
  type={type}
  class:list={[
    'inline-flex items-center justify-center rounded-sf px-4 py-2 text-sm font-medium',
    'transition-colors motion-reduce:transition-none',
    'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand',
    variantClass,
  ]}
>
  <slot />
</button>
