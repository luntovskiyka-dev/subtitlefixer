---
import Button from './Button.astro';
import Dropzone from './Dropzone.astro';
import ToolLayout from './ToolLayout.astro';
import ToolStatus from './ToolStatus.astro';

interface Props {
  direction: 'srt-to-vtt' | 'vtt-to-srt';
}

const { direction } = Astro.props;
const source = direction === 'srt-to-vtt' ? 'srt' : 'vtt';
const target = source === 'srt' ? 'vtt' : 'srt';
const sourceLabel = source === 'srt' ? 'SRT' : 'VTT';
const label = `Add one or more ${sourceLabel} files`;
const pill = `.${source} → .${target}`;
const chip = source === 'srt' ? 'SRT' : 'VTT';
---

<form
  id="convert-form"
  data-source={source}
  data-target={target}
  data-source-label={sourceLabel}
>
  <ToolLayout>
    <div slot="input" class="flex flex-col gap-3">
      <Dropzone
        id="convert-dropzone"
        variant="stage"
        label={label}
        stageTitle={label}
        formats={[{ label: chip, tone: source === 'srt' ? 'accent-soft' : 'mint' }]}
        interactive
      />
      <ToolStatus id="convert-status" tone="stage" />
    </div>
    <div slot="preview">
      <p id="convert-preview-empty" class="text-sm font-medium text-on-brand-muted">Add a file to preview the conversion.</p>
      <div
        id="convert-preview"
        class="rounded-sf-lg border-2.5 border-stage-line bg-surface px-4 py-3 text-ink sf-preview-scroll"
        tabindex="0"
        aria-label="Converted subtitle preview"
        hidden
      >
        <div class="mb-1.5 flex items-center justify-between gap-3">
          <p class="font-display text-lg font-extrabold">Preview</p>
          <p id="convert-preview-tag" class="rounded-full border-2 border-stage-line bg-footer-mint px-2.5 py-0.5 text-[12.5px] font-extrabold text-on-accent"></p>
        </div>
        <pre class="sf-preview-text"></pre>
      </div>
    </div>
    <div slot="settings">
      <p class="font-display text-[32px] font-extrabold leading-none tracking-tight">{pill}</p>
    </div>
    <div slot="action">
      <Button id="convert-download" type="submit" size="lg" class="w-full gap-2" softDisabled hint="Add a file to enable the download.">
        Download converted file
      </Button>
      <p class="mt-3.5 flex items-center justify-center gap-2 text-[13px] font-bold">
        Your file never leaves your device.
      </p>
      <div id="convert-result" class="mt-3" aria-live="polite"></div>
    </div>
  </ToolLayout>
</form>

<script>
  import type { DecodedSubtitleFile } from '../lib/subs/files';
  import { convertSubtitle, downloadSubtitleFiles } from '../lib/subs/index';
  import { slicePreviewCues } from '../lib/ui/previewSlice';
  import { renderStatus } from '../lib/ui/statusView';

  const form = document.getElementById('convert-form');
  const result = document.getElementById('convert-result');
  const status = document.getElementById('convert-status');
  const download = document.getElementById('convert-download');
  const hint = document.getElementById('convert-download-hint');
  const meta = document.querySelector('#convert-dropzone [data-file-meta]');

  let files: DecodedSubtitleFile[] = [];

  function isFormat(value: string | undefined): value is 'srt' | 'vtt' {
    return value === 'srt' || value === 'vtt';
  }

  function isDecodedFile(file: unknown): file is DecodedSubtitleFile {
    if (typeof file !== 'object' || file === null) return false;
    if (!('name' in file) || !('encoding' in file) || !('text' in file)) return false;
    return (
      typeof file.name === 'string' &&
      typeof file.encoding === 'string' &&
      typeof file.text === 'string'
    );
  }

  function replaceExtension(name: string, source: 'srt' | 'vtt', target: 'srt' | 'vtt'): string {
    return `${name.slice(0, -(source.length + 1))}.${target}`;
  }

  function showResult(messages: readonly string[], preview: string | null): void {
    if (!(result instanceof HTMLElement)) return;
    result.replaceChildren();
    for (const message of messages) {
      const paragraph = document.createElement('p');
      paragraph.className = 'sf-msg sf-rise';
      paragraph.textContent = message;
      result.append(paragraph);
    }
    const card = document.getElementById('convert-preview');
    const empty = document.getElementById('convert-preview-empty');
    const pre = card?.querySelector('pre');
    const tag = document.getElementById('convert-preview-tag');
    if (!(card instanceof HTMLElement) || !pre) return;
    if (preview === null) {
      card.hidden = true;
      if (empty instanceof HTMLElement) empty.hidden = false;
      return;
    }
    const sliced = slicePreviewCues(preview);
    pre.textContent = sliced.preview;
    if (tag instanceof HTMLElement) tag.textContent = sliced.caption;
    card.hidden = false;
    if (empty instanceof HTMLElement) empty.hidden = true;
  }

  if (
    form instanceof HTMLFormElement &&
    result instanceof HTMLElement &&
    status instanceof HTMLElement &&
    download instanceof HTMLButtonElement
  ) {
    const source = isFormat(form.dataset.source) ? form.dataset.source : null;
    const target = isFormat(form.dataset.target) ? form.dataset.target : null;
    const sourceLabel = form.dataset.sourceLabel === 'VTT' ? 'VTT' : 'SRT';
    const names = () => files.map((file) => file.name);

    const setDownload = (enabled: boolean) => {
      if (enabled) download.removeAttribute('aria-disabled');
      else download.setAttribute('aria-disabled', 'true');
      if (hint instanceof HTMLElement) hint.hidden = enabled;
    };

    const converted = () => {
      const messages: string[] = [];
      const ready: { name: string; text: string }[] = [];
      let preview: string | null = null;
      const article = source === 'srt' ? 'an' : 'a';
      if (!source || !target) return { messages, ready, preview };
      for (const file of files) {
        if (!file.name.toLowerCase().endsWith(`.${source}`)) {
          messages.push(`${file.name}: Use ${article} ${sourceLabel} file.`);
          continue;
        }
        const output = convertSubtitle(file.text, source, target);
        for (const error of output.errors) messages.push(`${file.name}: ${error.message}`);
        if (preview === null) preview = output.text;
        ready.push({
          name: replaceExtension(file.name, source, target),
          text: output.text,
        });
      }
      return { messages, ready, preview };
    };

    form.addEventListener('subtitlereading', () => {
      renderStatus(status, 'working', names());
    });

    form.addEventListener('subtitlefailed', () => {
      renderStatus(status, 'error', names());
    });

    form.addEventListener('subtitlefiles', (event) => {
      if (!(event instanceof CustomEvent)) return;
      const detail: unknown = event.detail;
      if (typeof detail !== 'object' || detail === null || !('files' in detail)) return;
      if (!Array.isArray(detail.files)) return;
      files = detail.files.filter(isDecodedFile);
      setDownload(files.length > 0);
      if (meta instanceof HTMLElement && files[0]) meta.textContent = files[0].encoding.replace(/^utf-8$/i, 'UTF-8');
      renderStatus(status, files.length > 0 ? 'loaded' : 'empty', names());
      if (files.length === 0) {
        showResult([], null);
        return;
      }
      const { messages, preview } = converted();
      showResult(messages, preview);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (download.getAttribute('aria-disabled') === 'true') return;
      if (!source || !target) return;
      const chosen = names();
      renderStatus(status, 'working', chosen);
      if (files.length === 0) {
        showResult([`Add one or more ${sourceLabel} files.`], null);
        renderStatus(status, 'error', chosen);
        return;
      }
      const { messages, ready, preview } = converted();
      showResult(messages, preview);
      if (ready.length > 0) {
        downloadSubtitleFiles(ready, false);
        renderStatus(status, 'ready', chosen);
        return;
      }
      renderStatus(status, 'error', chosen);
    });
  }
</script>
