---
import { render, type CollectionEntry } from 'astro:content';
import FaqList from './FaqList.astro';

interface Props {
  entry: CollectionEntry<'tools'>;
}

const { entry } = Astro.props;
const { h1, answer, faq } = entry.data;
const { Content } = await render(entry);
---

<div class="flex flex-col">
  <h1 class="text-3xl font-semibold tracking-tight">{h1}</h1>
  <p class="mt-6 text-lg leading-relaxed">{answer}</p>
  <section id="tool" class="mt-10">
    <slot />
  </section>
  <div class="sf-copy mt-16">
    <Content />
    <FaqList items={faq} />
  </div>
</div>
