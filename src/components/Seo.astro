---
import { ogImageFilename } from '../lib/og/card';
import { faqPageJsonLd, type FaqItem } from '../lib/seo/faqText';
import { buildJsonLd, type JsonLdInput } from '../lib/seo/jsonld';
import { BRAND, canonicalHref } from '../lib/seo/urls';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  image?: string;
  schema?: JsonLdInput['kind'];
  /** WebApplication name, or Article headline. */
  schemaName?: string;
  faq?: readonly FaqItem[];
}

const { title, description, path, noindex = false, image, schema = 'none', schemaName, faq } =
  Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error('Set site in astro.config.mjs to build canonical URLs.');
}

const canonical = canonicalHref(site, path);
const ogImage = image ?? new URL(`/og/${ogImageFilename(new URL(canonical).pathname)}`, site).href;

const jsonLdInput: JsonLdInput = (() => {
  if (schema === 'home') {
    return {
      kind: 'home',
      origin: site.origin,
      logo: new URL('/apple-touch-icon.png', site).href,
    };
  }
  if (schema === 'article' || schema === 'webapp') {
    const name = schemaName?.trim() ?? '';
    if (!name) throw new Error(`Missing schema name for ${schema}.`);
    if (schema === 'article') {
      return { kind: 'article', headline: name, description, url: canonical };
    }
    return { kind: 'webapp', name, description, url: canonical };
  }
  return { kind: 'none' };
})();

const jsonLdData = buildJsonLd(jsonLdInput);
const jsonLd = jsonLdData === null ? null : JSON.stringify(jsonLdData).replace(/</g, '\\u003c');
const faqJsonLd = faq && faq.length > 0 ? faqPageJsonLd(faq) : null;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={BRAND} />
<meta property="og:locale" content="en_US" />
{!noindex && <meta property="og:image" content={ogImage} />}
{!noindex && <meta property="og:image:width" content="1200" />}
{!noindex && <meta property="og:image:height" content="630" />}
{!noindex && <meta property="og:image:alt" content={title} />}
{!noindex && <link rel="alternate" hreflang="en" href={canonical} />}
{!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
{faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
