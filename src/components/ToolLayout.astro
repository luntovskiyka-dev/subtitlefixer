---
import { KOFI_URL } from '../config/site';
---

<div class="grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_384px] lg:gap-[26px]">
  <div class="flex min-w-0 flex-col gap-3">
    <slot name="input" />
    <slot name="preview" />
  </div>
  <div
    class="min-w-0 rounded-[26px] border-2.5 border-stage-line bg-surface p-4 text-ink shadow-hard lg:p-[22px] lg:shadow-hard-lg"
  >
    <slot name="settings" />
    <div class="mt-5">
      <slot name="action" />
      <p data-kofi-note hidden class="mt-3 text-center text-[13px] font-semibold text-muted">
        Saved you time?{' '}
        <a
          href={KOFI_URL}
          target="_blank"
          rel="noopener"
          class="rounded-sf text-accent-ink underline decoration-accent-ink underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-hover"
        >
          ☕ Buy me a coffee<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
  </div>
</div>
