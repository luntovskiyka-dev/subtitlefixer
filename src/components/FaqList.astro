---
import { renderInlineMarkdown, type FaqItem } from '../lib/seo/faqText';

interface Props {
  items: readonly FaqItem[];
}

const { items } = Astro.props;
---

<section aria-labelledby="faq-heading">
  <h2 id="faq-heading">FAQ</h2>
  <div class="sf-faq">
    {
      items.map((item, index) => (
        <details class="sf-faq-item" open={index === 0 || undefined}>
          <summary>
            <h3>{item.q}</h3>
          </summary>
          <div set:html={renderInlineMarkdown(item.a)} />
        </details>
      ))
    }
  </div>
</section>
