---
const presets = [
  '23.976 → 25',
  '25 → 23.976',
  '24 → 25',
  '25 → 24',
  '23.976 → 24',
  '24 → 23.976',
] as const;
---

<section
  class="rounded-[26px] border-2.5 border-stage-line bg-surface p-4 text-ink shadow-hard md:p-6"
  aria-labelledby="drift-fps-heading"
>
  <h2 id="drift-fps-heading" class="font-display text-[22px] font-extrabold">Subtitle frame rate converter</h2>
  <div role="group" aria-labelledby="drift-fps-label" class="mt-3">
    <p id="drift-fps-label" class="text-sm font-extrabold">subtitle fps → video fps</p>
    <div id="drift-fps" class="mt-3 flex flex-wrap gap-2">
      {presets.map((preset) => (
        <button type="button" class="sf-fps">
          {preset}
        </button>
      ))}
    </div>
  </div>
</section>
