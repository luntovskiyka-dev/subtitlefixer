---
import Button from './Button.astro';
import Dropzone from './Dropzone.astro';
import ToolLayout from './ToolLayout.astro';
import ToolStatus from './ToolStatus.astro';
import { SPRUCE_FPS } from '../lib/subs/stl';

const formats = [
  { label: 'EBU STL', tone: 'accent-soft' },
  { label: 'Spruce', tone: 'mint' },
] as const;
---

<form id="stl-form">
  <ToolLayout>
    <div slot="input" class="flex flex-col gap-3">
      <Dropzone
        id="stl-dropzone"
        variant="stage"
        label="Add one or more .stl subtitle files"
        stageTitle="Add one or more .stl subtitle files"
        accept=".stl"
        formats={formats}
        bytes
        note="Subtitle STL, not a 3D model."
        interactive
      />
      <ToolStatus id="stl-status" tone="stage" />
    </div>
    <div slot="preview">
      <p id="stl-preview-empty" class="text-sm font-medium text-on-brand-muted">Add a file to preview the conversion.</p>
      <div
        id="stl-preview"
        class="rounded-sf-lg border-2.5 border-stage-line bg-surface px-4 py-3 text-ink sf-preview-scroll"
        tabindex="0"
        aria-label="Converted subtitle preview"
        hidden
      >
        <div class="mb-1.5 flex items-center justify-between gap-3">
          <p class="font-display text-lg font-extrabold">Preview</p>
          <p id="stl-preview-tag" class="rounded-full border-2 border-stage-line bg-footer-mint px-2.5 py-0.5 text-[12.5px] font-extrabold text-on-accent"></p>
        </div>
        <pre class="sf-preview-text"></pre>
      </div>
    </div>
    <div slot="settings">
      <p class="font-display text-[32px] font-extrabold leading-none tracking-tight">.stl → .srt</p>
      <div class="mt-4 flex flex-col gap-2">
        <label for="stl-fps" class="text-sm font-extrabold">Spruce frame rate</label>
        <select id="stl-fps" name="fps" class="sf-field">
          {SPRUCE_FPS.map((fps) => (
            <option value={String(fps)} selected={fps === 25}>{fps} fps</option>
          ))}
        </select>
        <p class="text-sm text-muted">Used for Spruce STL. An EBU STL file already stores its frame rate.</p>
      </div>
      <div class="mt-4 flex flex-col gap-2">
        <label for="stl-output" class="text-sm font-extrabold">Output</label>
        <select id="stl-output" name="output" class="sf-field">
          <option value="srt" selected>SRT</option>
          <option value="vtt">VTT</option>
        </select>
      </div>
      <div class="mt-4 flex min-h-11 items-center gap-3">
        <input id="stl-bom" name="bom" type="checkbox" class="sf-check" />
        <label for="stl-bom" class="text-sm font-extrabold">Add BOM (old players)</label>
      </div>
    </div>
    <div slot="action">
      <Button id="stl-download" type="submit" size="lg" class="w-full gap-2" softDisabled hint="Add a file to enable the download.">
        <span id="stl-download-label">Download SRT file</span>
      </Button>
      <p class="mt-3.5 flex items-center justify-center gap-2 text-[13px] font-bold">Your file never leaves your device.</p>
      <div id="stl-result" class="mt-3" aria-live="polite"></div>
    </div>
  </ToolLayout>
</form>

<script>
  import { downloadSubtitleFiles } from '../lib/subs/index';
  import { parseStl, stlOutputName, stlToText, type StlKind } from '../lib/subs/stl';
  import { slicePreviewCues } from '../lib/ui/previewSlice';
  import { renderStatus } from '../lib/ui/statusView';

  type ByteFile = { name: string; bytes: Uint8Array };

  const form = document.getElementById('stl-form');
  const result = document.getElementById('stl-result');
  const status = document.getElementById('stl-status');
  const download = document.getElementById('stl-download');
  const hint = document.getElementById('stl-download-hint');
  const label = document.getElementById('stl-download-label');
  const fpsInput = document.getElementById('stl-fps');
  const output = document.getElementById('stl-output');
  const bomInput = document.getElementById('stl-bom');

  let files: ByteFile[] = [];

  function isByteFile(file: unknown): file is ByteFile {
    if (typeof file !== 'object' || file === null) return false;
    if (!('name' in file) || !('bytes' in file)) return false;
    return typeof file.name === 'string' && file.bytes instanceof Uint8Array;
  }

  function fps(): number {
    const value = fpsInput instanceof HTMLSelectElement ? Number(fpsInput.value) : 25;
    return Number.isFinite(value) && value > 0 ? value : 25;
  }

  function format(): 'srt' | 'vtt' {
    return output instanceof HTMLSelectElement && output.value === 'vtt' ? 'vtt' : 'srt';
  }

  function kindLabel(kind: StlKind | null): string {
    if (kind === 'ebu') return 'EBU STL';
    if (kind === 'spruce') return 'Spruce STL';
    return '';
  }

  function showResult(messages: readonly string[], preview: string | null, kind: StlKind | null): void {
    if (!(result instanceof HTMLElement)) return;
    result.replaceChildren();
    for (const message of messages) {
      const paragraph = document.createElement('p');
      paragraph.className = 'sf-msg sf-rise';
      paragraph.textContent = message;
      result.append(paragraph);
    }
    const card = document.getElementById('stl-preview');
    const empty = document.getElementById('stl-preview-empty');
    const pre = card?.querySelector('pre');
    const tag = document.getElementById('stl-preview-tag');
    if (!(card instanceof HTMLElement) || !pre) return;
    if (preview === null) {
      card.hidden = true;
      if (empty instanceof HTMLElement) empty.hidden = false;
      return;
    }
    const sliced = slicePreviewCues(preview);
    pre.textContent = sliced.preview;
    const name = kindLabel(kind);
    if (tag instanceof HTMLElement) tag.textContent = name ? `${name} · ${sliced.caption}` : sliced.caption;
    card.hidden = false;
    if (empty instanceof HTMLElement) empty.hidden = true;
  }

  if (
    form instanceof HTMLFormElement &&
    fpsInput instanceof HTMLSelectElement &&
    output instanceof HTMLSelectElement &&
    bomInput instanceof HTMLInputElement &&
    status instanceof HTMLElement &&
    download instanceof HTMLButtonElement
  ) {
    const names = () => files.map((file) => file.name);
    const setDownload = (enabled: boolean) => {
      if (enabled) download.removeAttribute('aria-disabled');
      else download.setAttribute('aria-disabled', 'true');
      if (hint instanceof HTMLElement) hint.hidden = enabled;
    };

    const converted = async () => {
      const chosen = format();
      const messages: string[] = [];
      const ready: { name: string; text: string }[] = [];
      let preview: string | null = null;
      let kind: StlKind | null = null;
      for (const file of files) {
        const parsed = await parseStl(file.bytes, fps());
        if (kind === null) kind = parsed.kind;
        for (const warning of parsed.warnings) messages.push(`${file.name}: ${warning}`);
        const text = stlToText(parsed, chosen);
        if (parsed.error || text.text === '') {
          messages.push(`${file.name}: ${parsed.error ?? 'No subtitles found in this STL file.'}`);
          continue;
        }
        if (preview === null) preview = text.text;
        ready.push({ name: stlOutputName(file.name, chosen), text: text.text });
      }
      if (label instanceof HTMLElement) label.textContent = `Download ${chosen.toUpperCase()} file`;
      return { messages, ready, preview, kind };
    };

    const refresh = () => {
      if (files.length === 0) return;
      void converted().then((next) => {
        showResult(next.messages, next.preview, next.kind);
      });
    };

    fpsInput.addEventListener('change', refresh);
    output.addEventListener('change', refresh);
    form.addEventListener('subtitlefiles', (event) => {
      if (!(event instanceof CustomEvent) || !Array.isArray(event.detail?.files)) return;
      files = event.detail.files.filter(isByteFile);
      setDownload(files.length > 0);
      renderStatus(status, files.length > 0 ? 'loaded' : 'empty', names());
      if (files.length === 0) {
        showResult([], null, null);
        return;
      }
      refresh();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (download.getAttribute('aria-disabled') === 'true') return;
      const chosen = names();
      renderStatus(status, 'working', chosen);
      void converted().then((next) => {
        showResult(next.messages, next.preview, next.kind);
        if (next.ready.length > 0) {
          downloadSubtitleFiles(next.ready, bomInput.checked);
          renderStatus(status, 'ready', chosen);
          return;
        }
        renderStatus(status, 'error', chosen);
      });
    });
  }
</script>
