---
import Button from './Button.astro';
import Dropzone from './Dropzone.astro';
import ToolLayout from './ToolLayout.astro';
import ToolStatus from './ToolStatus.astro';

interface Props {
  output?: 'srt' | 'vtt';
}

const { output = 'srt' } = Astro.props;
const formats = [
  { label: 'ASS', tone: 'lilac' },
  { label: 'SSA', tone: 'teal-soft' },
] as const;
const extension = output === 'vtt' ? 'vtt' : 'srt';
---

<form id="ass-form" data-output={extension}>
  <ToolLayout>
    <div slot="input" class="flex flex-col gap-3">
      <Dropzone
        id="ass-dropzone"
        variant="stage"
        label="Add one or more ASS or SSA files"
        stageTitle="Add one or more ASS or SSA files"
        formats={formats}
        interactive
      />
      <ToolStatus id="ass-status" tone="stage" />
    </div>
    <div slot="preview">
      <p id="ass-preview-empty" class="text-sm font-medium text-on-brand-muted">Add a file to preview the conversion.</p>
      <div
        id="ass-preview"
        class="rounded-sf-lg border-2.5 border-stage-line bg-surface px-4 py-3 text-ink sf-preview-scroll"
        tabindex="0"
        aria-label="Converted subtitle preview"
        hidden
      >
        <div class="mb-1.5 flex items-center justify-between gap-3">
          <p class="font-display text-lg font-extrabold">Preview</p>
          <p id="ass-preview-tag" class="rounded-full border-2 border-stage-line bg-footer-mint px-2.5 py-0.5 text-[12.5px] font-extrabold text-on-accent"></p>
        </div>
        <pre class="sf-preview-text"></pre>
      </div>
    </div>
    <div slot="settings">
      <p class="font-display text-[32px] font-extrabold leading-none tracking-tight">.ass/.ssa → .{extension}</p>
      <div class="mt-4 flex min-h-11 items-center gap-3">
        <input id="ass-bom" name="bom" type="checkbox" class="sf-check" />
        <label for="ass-bom" class="text-sm font-extrabold">Add BOM (old players)</label>
      </div>
    </div>
    <div slot="action">
      <Button id="ass-download" type="submit" size="lg" class="w-full gap-2" softDisabled hint="Add a file to enable the download.">
        Download {extension.toUpperCase()} file
      </Button>
      <p class="mt-3.5 flex items-center justify-center gap-2 text-[13px] font-bold">
        Your file never leaves your device.
      </p>
      <div id="ass-result" class="mt-3" aria-live="polite"></div>
    </div>
  </ToolLayout>
</form>

<script>
  import type { DecodedSubtitleFile } from '../lib/subs/files';
  import { assToText } from '../lib/subs/assToSrt';
  import { downloadSubtitleFiles } from '../lib/subs/index';
  import { slicePreviewCues } from '../lib/ui/previewSlice';
  import { renderStatus } from '../lib/ui/statusView';

  const form = document.getElementById('ass-form');
  const result = document.getElementById('ass-result');
  const status = document.getElementById('ass-status');
  const download = document.getElementById('ass-download');
  const hint = document.getElementById('ass-download-hint');
  const meta = document.querySelector('#ass-dropzone [data-file-meta]');
  const bomInput = document.getElementById('ass-bom');

  let files: DecodedSubtitleFile[] = [];

  function isDecodedFile(file: unknown): file is DecodedSubtitleFile {
    if (typeof file !== 'object' || file === null) return false;
    if (!('name' in file) || !('encoding' in file) || !('text' in file)) return false;
    return (
      typeof file.name === 'string' &&
      typeof file.encoding === 'string' &&
      typeof file.text === 'string'
    );
  }

  function isAssName(name: string): boolean {
    const lower = name.toLowerCase();
    return lower.endsWith('.ass') || lower.endsWith('.ssa');
  }

  function outputFormat(): 'srt' | 'vtt' {
    return form instanceof HTMLFormElement && form.dataset.output === 'vtt' ? 'vtt' : 'srt';
  }

  function outputName(name: string): string {
    return name.replace(/\.(?:ass|ssa)$/i, `.${outputFormat()}`);
  }

  function showResult(messages: readonly string[], preview: string | null): void {
    if (!(result instanceof HTMLElement)) return;
    result.replaceChildren();
    for (const message of messages) {
      const paragraph = document.createElement('p');
      paragraph.className = 'sf-msg sf-rise';
      paragraph.textContent = message;
      result.append(paragraph);
    }
    const card = document.getElementById('ass-preview');
    const empty = document.getElementById('ass-preview-empty');
    const pre = card?.querySelector('pre');
    const tag = document.getElementById('ass-preview-tag');
    if (!(card instanceof HTMLElement) || !pre) return;
    if (preview === null) {
      card.hidden = true;
      if (empty instanceof HTMLElement) empty.hidden = false;
      return;
    }
    const sliced = slicePreviewCues(preview);
    pre.textContent = sliced.preview;
    if (tag instanceof HTMLElement) tag.textContent = sliced.caption;
    card.hidden = false;
    if (empty instanceof HTMLElement) empty.hidden = true;
  }

  if (
    form instanceof HTMLFormElement &&
    bomInput instanceof HTMLInputElement &&
    result instanceof HTMLElement &&
    status instanceof HTMLElement &&
    download instanceof HTMLButtonElement
  ) {
    const names = () => files.map((file) => file.name);

    const setDownload = (enabled: boolean) => {
      if (enabled) download.removeAttribute('aria-disabled');
      else download.setAttribute('aria-disabled', 'true');
      if (hint instanceof HTMLElement) hint.hidden = enabled;
    };

    const converted = () => {
      const messages: string[] = [];
      const ready: { name: string; text: string }[] = [];
      let preview: string | null = null;
      for (const file of files) {
        if (!isAssName(file.name)) {
          messages.push(`${file.name}: Use an ASS or SSA file.`);
          continue;
        }
        const output = assToText(file.text, outputFormat());
        for (const error of output.errors) messages.push(`${file.name}: ${error.message}`);
        if (preview === null) preview = output.text;
        ready.push({
          name: outputName(file.name),
          text: output.text,
        });
      }
      return { messages, ready, preview };
    };

    form.addEventListener('subtitlereading', () => {
      renderStatus(status, 'working', names());
    });

    form.addEventListener('subtitlefailed', () => {
      renderStatus(status, 'error', names());
    });

    form.addEventListener('subtitlefiles', (event) => {
      if (!(event instanceof CustomEvent)) return;
      const detail: unknown = event.detail;
      if (typeof detail !== 'object' || detail === null || !('files' in detail)) return;
      if (!Array.isArray(detail.files)) return;
      files = detail.files.filter(isDecodedFile);
      setDownload(files.length > 0);
      if (meta instanceof HTMLElement && files[0]) meta.textContent = files[0].encoding.replace(/^utf-8$/i, 'UTF-8');
      renderStatus(status, files.length > 0 ? 'loaded' : 'empty', names());
      if (files.length === 0) {
        showResult([], null);
        return;
      }
      const { messages, preview } = converted();
      showResult(messages, preview);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (download.getAttribute('aria-disabled') === 'true') return;
      const chosen = names();
      renderStatus(status, 'working', chosen);
      if (files.length === 0) {
        showResult(['Add one or more ASS or SSA files.'], null);
        renderStatus(status, 'error', chosen);
        return;
      }
      const { messages, ready, preview } = converted();
      showResult(messages, preview);
      if (ready.length > 0) {
        downloadSubtitleFiles(ready, bomInput.checked);
        renderStatus(status, 'ready', chosen);
        return;
      }
      renderStatus(status, 'error', chosen);
    });
  }
</script>
