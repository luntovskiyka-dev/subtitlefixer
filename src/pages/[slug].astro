---
import { getCollection, type CollectionEntry } from 'astro:content';
import AssToSrtTool from '../components/AssToSrtTool.astro';
import ConvertTool from '../components/ConvertTool.astro';
import DriftFps from '../components/DriftFps.astro';
import DriftTool from '../components/DriftTool.astro';
import EditorTool from '../components/EditorTool.astro';
import EncodingTool from '../components/EncodingTool.astro';
import MergeTool from '../components/MergeTool.astro';
import ShiftTool from '../components/ShiftTool.astro';
import SmiToSrtTool from '../components/SmiToSrtTool.astro';
import SrtToTxtTool from '../components/SrtToTxtTool.astro';
import SrtToWordTool from '../components/SrtToWordTool.astro';
import SbvToSrtTool from '../components/SbvToSrtTool.astro';
import SubToSrtTool from '../components/SubToSrtTool.astro';
import SupToSrtTool from '../components/SupToSrtTool.astro';
import ToolPage from '../components/ToolPage.astro';
import TxtToSrtTool from '../components/TxtToSrtTool.astro';
import { tools } from '../data/tools';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('tools');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'tools'>;
}

const { entry } = Astro.props;
const { title, description, faq } = entry.data;
const toolName = tools[entry.id as keyof typeof tools];
if (!toolName) throw new Error(`Missing tool name for /${entry.id}.`);
---

<Base
  title={title}
  description={description}
  schema="webapp"
  schemaName={toolName}
  faq={faq}
  width="wide"
  spacing="tight"
>
  <ToolPage entry={entry}>
    {entry.id === 'shift-subtitles' && <ShiftTool />}
    {entry.id === 'fix-subtitle-encoding' && <EncodingTool />}
    {entry.id === 'srt-editor' && <EditorTool />}
    {entry.id === 'srt-to-vtt' && <ConvertTool direction="srt-to-vtt" />}
    {entry.id === 'vtt-to-srt' && <ConvertTool direction="vtt-to-srt" />}
    {entry.id === 'ass-to-srt' && <AssToSrtTool />}
    {entry.id === 'srt-to-txt' && <SrtToTxtTool />}
    {entry.id === 'vtt-to-txt' && <SrtToTxtTool variant="vtt" />}
    {entry.id === 'srt-to-word' && <SrtToWordTool />}
    {entry.id === 'txt-to-srt' && <TxtToSrtTool />}
    {entry.id === 'sub-to-srt' && <SubToSrtTool />}
    {entry.id === 'sup-to-srt' && <SupToSrtTool />}
    {entry.id === 'sbv-to-srt' && <SbvToSrtTool />}
    {entry.id === 'smi-to-srt' && <SmiToSrtTool />}
    {entry.id === 'merge-subtitles' && <MergeTool />}
    {entry.id === 'fix-subtitle-drift' && <DriftTool />}
    {entry.id === 'fix-subtitle-drift' && <DriftFps slot="below" />}
  </ToolPage>
</Base>
