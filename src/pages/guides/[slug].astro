---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { title, description, h1, answer, faq } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={description} schema="article" schemaName={h1} faq={faq}>
  <article>
    <h1 class="text-3xl font-display font-extrabold tracking-tight">{h1}</h1>
    <p class="mt-6 text-lg leading-relaxed">{answer}</p>
    <div class="sf-copy mt-10">
      <Content />
    </div>
  </article>
</Base>
