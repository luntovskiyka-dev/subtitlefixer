---
import Base from '../layouts/Base.astro';

const linkClass =
  'rounded-sf text-brand hover:text-brand-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand';
---

<Base
  title="About — subtitlefixer"
  description="subtitlefixer is a set of free browser tools for SRT, VTT, and ASS. Files stay on the device."
>
  <h1 class="text-3xl font-semibold tracking-tight">About</h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed">
    subtitlefixer is a set of free browser tools for SRT, VTT, and ASS. Files stay on the device.
  </p>
  <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
    <a href="/" class={linkClass}>Home</a>
    <a href="/privacy" class={linkClass}>Privacy</a>
  </p>
</Base>
