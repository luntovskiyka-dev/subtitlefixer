---
import { getEntry, render } from 'astro:content';
import Mark from '../components/Mark.astro';
import ProblemCards from '../components/ProblemCards.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { homeTrust } from '../data/tools';
import Base from '../layouts/Base.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing home page content.');
const { title, description, h1, faq } = entry.data;
if (!h1 || !faq) throw new Error('Home page is missing h1 or faq.');
const { Content } = await render(entry);
const mark = 'Subtitles';
const markAt = h1.indexOf(mark);
---

<Base title={title} description={description} schema="home" faq={faq} width="wide" spacing="tight">
  <section class="sf-hero">
    <div class="sf-hero-blob sf-hero-blob-a" aria-hidden="true"></div>
    <div class="sf-hero-blob sf-hero-blob-b" aria-hidden="true"></div>
    <div class="sf-hero-body">
      <h1 class="sf-hero-title">
        {
          markAt >= 0 ? (
            <>
              {h1.slice(0, markAt)}
              <Mark>{mark}</Mark>
              {h1.slice(markAt + mark.length)}
            </>
          ) : (
            h1
          )
        }
      </h1>
      <ul class="sf-trust">
        {
          homeTrust.map((label) => (
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <ProblemCards />
  <ToolGrid />
  <div class="sf-copy mt-16">
    <Content />
  </div>
</Base>