---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing home page content.');
const { title, description, h1, answer, faq } = entry.data;
if (!h1 || !answer || !faq) throw new Error('Home page is missing h1, answer, or faq.');
const { Content } = await render(entry);
---

<Base title={title} description={description} schema="home" faq={faq} width="wide">
  <h1 class="text-3xl font-display font-extrabold tracking-tight">{h1}</h1>
  <p class="mt-6 text-lg leading-relaxed">{answer}</p>
  <div class="sf-copy mt-10">
    <Content />
  </div>
</Base>
