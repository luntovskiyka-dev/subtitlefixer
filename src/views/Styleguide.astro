---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Dropzone from '../components/Dropzone.astro';
import Input from '../components/Input.astro';
import Mark from '../components/Mark.astro';
import SubtitlePreview from '../components/SubtitlePreview.astro';
import ToolIcon from '../components/ToolIcon.astro';
import ToolStatus from '../components/ToolStatus.astro';
import { toolMeta } from '../data/tools';

const cues = [
  { start: 12400, end: 15120, text: 'We should have left an hour ago.' },
  { start: 62040, end: 65800, text: 'The train does not wait.' },
];
---

<Base
  title="Internal component set | SubtitleFixer"
  description="Internal component set for SubtitleFixer controls. This page is not a public tool."
  noindex
  width="wide"
>
  <h1 class="text-3xl font-display font-extrabold leading-snug tracking-tight">
    Internal <Mark>component</Mark> set
  </h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed">
    Internal component set for the controls on tool pages.
  </p>

  <div class="mt-16 flex flex-col gap-16">
    <section aria-labelledby="buttons-heading">
      <h2 id="buttons-heading" class="text-xl font-semibold tracking-tight">Buttons</h2>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Button variant="primary">Shift</Button>
        <Button variant="secondary">Copy offset</Button>
        <Button variant="ghost">Clear</Button>
        <Button variant="primary" size="lg">Download shifted file</Button>
      </div>
      <div class="mt-6 rounded-sf-lg bg-brand p-6">
        <Button variant="on-stage">Choose files</Button>
      </div>
      <div class="mt-6">
        <Button id="download-disabled" variant="primary" disabled hint="Add a file to enable the download.">
          Download shifted file
        </Button>
      </div>
    </section>

    <section aria-labelledby="icons-heading">
      <h2 id="icons-heading" class="text-xl font-semibold tracking-tight">Tool icons</h2>
      <div class="mt-6 flex flex-wrap items-end gap-4">
        {
          toolMeta.map((tool) => (
            <ToolIcon name={tool.key} size="m" />
          ))
        }
        <ToolIcon name="shift" size="s" />
        <ToolIcon name="shift" size="l" />
      </div>
    </section>

    <section aria-labelledby="dropzone-heading">
      <h2 id="dropzone-heading" class="text-xl font-semibold tracking-tight">Dropzone</h2>
      <div class="mt-6">
        <Dropzone id="dropzone" label="Drop a subtitle file" interactive />
      </div>
      <p class="mt-3 text-sm text-muted">Names of chosen files appear below. Files stay on this device.</p>
      <ul id="dropzone-files" class="mt-3 list-inside list-disc text-sm empty:hidden" aria-live="polite"></ul>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <div>
          <h3 class="text-sm font-medium text-muted">Hover</h3>
          <div class="mt-3">
            <Dropzone id="dropzone-hover" label="Drop a subtitle file" state="hover" />
          </div>
        </div>
        <div>
          <h3 class="text-sm font-medium text-muted">Drag</h3>
          <div class="mt-3">
            <Dropzone id="dropzone-drag" label="Drop a subtitle file" state="drag" />
          </div>
        </div>
        <div>
          <h3 class="text-sm font-medium text-muted">Error</h3>
          <div class="mt-3">
            <Dropzone id="dropzone-error" label="Drop a subtitle file" state="error" />
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="status-heading">
      <h2 id="status-heading" class="text-xl font-semibold tracking-tight">Status</h2>
      <div class="mt-6 flex flex-col gap-8">
        <div>
          <h3 class="text-sm font-medium text-muted">Empty</h3>
          <div class="mt-3">
            <ToolStatus id="status-empty" phase="empty" />
          </div>
        </div>
        <div>
          <h3 class="text-sm font-medium text-muted">File ready</h3>
          <div class="mt-3">
            <ToolStatus id="status-loaded" phase="loaded" fileNames={['episode.srt']} />
          </div>
        </div>
        <div>
          <h3 class="text-sm font-medium text-muted">Working</h3>
          <div class="mt-3">
            <ToolStatus id="status-working" phase="working" />
          </div>
        </div>
        <div>
          <h3 class="text-sm font-medium text-muted">Error</h3>
          <div class="mt-3">
            <ToolStatus id="status-error" phase="error" />
          </div>
        </div>
        <div>
          <h3 class="text-sm font-medium text-muted">Ready</h3>
          <div class="mt-3">
            <ToolStatus id="status-ready" phase="ready" />
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="badge-heading">
      <h2 id="badge-heading" class="text-xl font-semibold tracking-tight">Badge</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        <Badge>SRT</Badge>
        <Badge>VTT</Badge>
        <Badge>ASS</Badge>
      </div>
    </section>

    <section aria-labelledby="card-heading">
      <h2 id="card-heading" class="text-xl font-semibold tracking-tight">Card</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <Card>
          <p class="leading-relaxed">A cue list sits on a surface with a quiet border.</p>
        </Card>
        <Card variant="pop">
          <p class="leading-relaxed">A popped card keeps an ink outline and a hard shadow.</p>
        </Card>
      </div>
    </section>

    <section aria-labelledby="fields-heading">
      <h2 id="fields-heading" class="text-xl font-semibold tracking-tight">Fields</h2>
      <div class="mt-6 flex flex-col gap-6">
        <Input id="offset-ms" label="Offset in milliseconds" kind="milliseconds" />
        <Input id="encoding" label="Encoding" kind="encoding" />
        <Input
          id="hero-offset"
          label="Offset (ms)"
          kind="milliseconds"
          variant="hero"
          suffix="ms"
          hint="1 s = 1000 ms"
          value="-2500"
        />
      </div>
    </section>

    <section aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="text-xl font-semibold tracking-tight">Subtitle preview</h2>
      <div class="mt-6">
        <Card>
          <SubtitlePreview cues={cues} />
        </Card>
      </div>
    </section>
  </div>
</Base>

<script>
  const zone = document.getElementById('dropzone');
  const list = document.getElementById('dropzone-files');

  zone?.addEventListener('subtitlefiles', (event) => {
    if (!(event instanceof CustomEvent) || !(list instanceof HTMLUListElement)) return;
    const detail = event.detail as { files?: { name?: string }[] };
    const files = Array.isArray(detail.files) ? detail.files : [];
    list.replaceChildren(
      ...files.map((file) => {
        const item = document.createElement('li');
        item.textContent = file.name ?? '';
        return item;
      }),
    );
  });
</script>
