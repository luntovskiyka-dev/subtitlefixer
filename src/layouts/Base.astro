---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} path={Astro.url.pathname} noindex={noindex} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-bg font-sans text-ink antialiased">
    <Header />
    <main class="mx-auto w-full min-w-0 max-w-3xl flex-1 px-4 py-16 sm:px-6 sm:py-24">
      <slot />
    </main>
    <Footer />
  </body>
</html>
